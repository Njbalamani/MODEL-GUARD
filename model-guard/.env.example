MG_SECRET_KEY=replace-with-a-long-random-secret
MG_DEBUG=true
MG_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MG_MAX_UPLOAD_BYTES=209715200
MG_SAMPLE_ROWS=400
MG_FGSM_EPSILON=0.12
MG_PGD_EPSILON=0.12
MG_PGD_STEPS=8
MG_PGD_STEP_SIZE=0.03
MG_PATCH_FEATURES=1
MG_GAUSSIAN_SIGMA=0.15
MG_PRIVACY_GAP_THRESHOLD=0.15
MG_DRIFT_PSI_THRESHOLD=0.2
MG_DRIFT_WATCH_THRESHOLD=0.1
MG_ENABLE_SHAP=true
MG_ENABLE_ART=false
MG_ENABLE_ONNX=true
MG_ONNX_MAX_NODES=1000
MG_ONNX_ALLOWED_DOMAINS=,ai.onnx
MG_ASSESSMENT_TIMEOUT=300
MG_RESCAN_MIN_INTERVAL_MINUTES=15
MG_REPORT_SIGNING_KEY=replace-with-a-separate-long-random-signing-key
MG_WEBHOOK_TIMEOUT=3.0
MG_WEBHOOK_MAX_BYTES=1048576
MG_ALLOW_PRIVATE_WEBHOOKS=false
MG_API_RATE_LIMIT=1000/hour
MG_LOG_LEVEL=INFO
